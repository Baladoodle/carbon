{
  "name": "carbon",
  "version": "0.1.0",
  "private": true,
  "description": "A live design studio for Infinite, with AI built in.",
  "desktopName": "carbon.desktop",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs",
    "test:e2e:smoke": "npm run build && node scripts/run-e2e.mjs --grep @smoke",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run test:e2e:smoke",
    "eval": "node scripts/eval.mjs",
    "smoke:ai": "node scripts/smoke-ai.mjs",
    "dist": "npm run build && electron-builder --linux --config electron-builder.json",
    "postinstall": "node scripts/ensure-electron.mjs",
    "fixtures:sample": "UPDATE_FIXTURES=1 vitest run src/main/store/world-dir.test.ts",
    "dev:sample": "node scripts/dev-sample.mjs",
    "guide:keys": "npm run build && UPDATE_GUIDE=1 node scripts/run-e2e.mjs e2e/keys.spec.ts",
    "smoke:images": "node scripts/smoke-images.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "openai": "^7.51.0",
    "pngjs": "^7.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
