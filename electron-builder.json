{
  "appId": "dev.baladoodle.carbon",
  "productName": "carbon",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": ["out/**/*", "package.json"],
  "asarUnpack": [],
  "artifactName": "${productName}-${version}-${arch}.${ext}",
  "linux": {
    "target": ["AppImage", "dir"],
    "category": "Development",
    "executableName": "carbon",
    "synopsis": "A live design studio for Infinite",
    "desktop": {
      "entry": {
        "Name": "carbon",
        "StartupWMClass": "carbon",
        "Terminal": "false"
      }
    },
    "syncDesktopName": true
  }
}
